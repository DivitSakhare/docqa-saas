# Copy to .env and fill in real values. Never commit .env.

# Postgres connection for the control-plane + all tenant schemas (same DB instance).
DATABASE_URL=postgresql+psycopg://docqa:docqa@localhost:5432/docqa

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Local disk path where uploaded documents are stored, one subfolder per tenant schema.
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=26214400

# Celery's broker. Required by both the API (to enqueue ingestion jobs) and
# the celery worker (to consume them). No result backend configured —
# Postgres is the source of truth for job status, not Celery.
REDIS_URL=redis://localhost:6379/0

# Required only to run the ingestion worker
# (celery -A docqa.celery_app worker --loglevel=info) — the API itself runs
# fine without these. Get a key at https://build.nvidia.com
NVIDIA_API_KEY=
# Get a key at https://app.pinecone.io
PINECONE_API_KEY=

EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
EMBEDDING_DIMENSION=2048
PINECONE_INDEX_NAME=docqa-saas
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
INGESTION_MAX_ATTEMPTS=3
INGESTION_RATE_LIMIT=40/m

CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
CHAT_TIMEOUT_SECONDS=30
CHAT_MAX_TOKENS=1024
CHAT_TOP_K=5
CHAT_SCORE_THRESHOLD=0.2
CHAT_HISTORY_TURNS=5
